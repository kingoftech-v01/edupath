[run]
source = accounts,courses,blog,core
omit =
    */migrations/*
    */tests/*
    */__init__.py
    */admin.py
branch = True

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
show_missing = True
precision = 2

[html]
directory = htmlcov
